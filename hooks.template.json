{
  "description": "Agent Run Tracker hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/agent-run-tracker/track_prompt.py\"",
            "timeout": 15,
            "statusMessage": "Starting agent run tracker"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/agent-run-tracker/track_stop.py\"",
            "timeout": 15,
            "statusMessage": "Scoring agent run"
          }
        ]
      }
    ]
  }
}
